@model LostFound.Models.Item

<div class="card item-card h-100 shadow-sm">
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" class="card-img-top" alt="@Model.Title" />
    }
    else
    {
        <div class="img-placeholder"><i class="bi bi-image"></i></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge @(Model.Type == LostFound.Models.ItemType.Lost ? "badge-lost" : "badge-found") text-white">
                @Model.Type
            </span>
            <span class="badge bg-secondary">@Model.Category</span>
        </div>
        <h6 class="card-title fw-semibold">@Model.Title</h6>
        <p class="card-text text-muted small flex-grow-1">
            @(Model.Description != null && Model.Description.Length > 80 ? Model.Description[..80] + "…" : Model.Description)
        </p>
        <div class="small text-muted mb-2">
            <i class="bi bi-geo-alt me-1"></i>@Model.Location
        </div>
        <div class="small text-muted mb-3">
            <i class="bi bi-calendar me-1"></i>@Model.DateOccurred.ToString("MMM dd, yyyy")
        </div>
        <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-outline-primary btn-sm mt-auto">View Details</a>
    </div>
</div>
