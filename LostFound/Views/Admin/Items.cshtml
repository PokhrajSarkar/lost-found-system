@model IEnumerable<LostFound.Models.Item>
@using LostFound.Models
@{
    ViewData["Title"] = "Manage Items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Manage Items</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Dashboard</a>
</div>

<form method="get" class="d-flex gap-2 mb-3">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search..." style="max-width:300px" />
    <div class="form-check form-switch d-flex align-items-center gap-2 ms-2">
        <input class="form-check-input" type="checkbox" name="pendingOnly" value="true" id="pendingCheck" @(ViewBag.PendingOnly == true ? "checked" : "") onchange="this.form.submit()" />
        <label class="form-check-label" for="pendingCheck">Pending only</label>
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr><th>Title</th><th>Type</th><th>User</th><th>Status</th><th>Approved</th><th>Posted</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(!item.IsApproved ? "table-warning" : "")">
                    <td><a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td>
                    <td><span class="badge @(item.Type == ItemType.Lost ? "badge-lost" : "badge-found") text-white">@item.Type</span></td>
                    <td class="small">@(item.User?.FullName ?? "—")</td>
                    <td><span class="badge bg-secondary">@item.Status</span></td>
                    <td>
                        @if (item.IsApproved)
                        {
                            <i class="bi bi-check-circle text-success"></i>
                        }
                        else
                        {
                            <i class="bi bi-clock text-warning"></i>
                        }
                    </td>
                    <td class="small text-muted">@item.DatePosted.ToString("MMM dd, yyyy")</td>
                    <td>
                        <div class="d-flex gap-1">
                            @if (!item.IsApproved)
                            {
                                <form asp-action="ApproveItem" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                        <i class="bi bi-check"></i>
                                    </button>
                                </form>
                                <form asp-action="RejectItem" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" title="Reject">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </form>
                            }
                            <a asp-controller="Items" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
