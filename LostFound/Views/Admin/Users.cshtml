@model IEnumerable<LostFound.Models.User>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Manage Users</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Dashboard</a>
</div>

<form method="get" class="d-flex gap-2 mb-3">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name or email..." style="max-width:300px" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr><th>Name</th><th>Email</th><th>Phone</th><th>Joined</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                bool banned = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
                <tr class="@(banned ? "table-danger" : "")">
                    <td class="fw-semibold">@user.FullName</td>
                    <td class="small">@user.Email</td>
                    <td class="small">@(user.PhoneNumber ?? "—")</td>
                    <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td>
                        @if (banned)
                        {
                            <span class="badge bg-danger">Banned</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            @if (!banned)
                            {
                                <form asp-action="BanUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" title="Ban">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                </form>
                                <form asp-action="MakeAdmin" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Make Admin">
                                        <i class="bi bi-shield-plus"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="UnbanUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success" title="Unban">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
