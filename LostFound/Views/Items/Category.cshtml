@model IEnumerable<LostFound.Models.Item>
@using LostFound.Models
@{
    ViewData["Title"] = $"{ViewBag.Category} Items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-tag me-2"></i>@ViewBag.Category
        <span class="badge bg-secondary ms-2">@Model.Count()</span>
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Items</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
        <p>No active items in this category.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                @await Html.PartialAsync("_ItemCard", item)
            </div>
        }
    </div>
}

<div class="mt-4">
    <h5>Browse by Category</h5>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var cat in new[] { "Electronics", "Clothing", "Bags", "Jewelry", "Documents", "Keys", "Pets", "Other" })
        {
            <a asp-action="Category" asp-route-cat="@cat"
               class="btn btn-sm @(ViewBag.Category?.ToString() == cat ? "btn-primary" : "btn-outline-secondary")">
                @cat
            </a>
        }
    </div>
</div>
