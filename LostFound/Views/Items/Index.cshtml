@model IEnumerable<LostFound.Models.Item>
@using LostFound.Models
@{
    ViewData["Title"] = "Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Lost &amp; Found Items</h1>
    <a asp-action="Create" class="btn btn-primary">+ Report Item</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width:400px;">
        <input type="text" name="searchString" class="form-control" placeholder="Search by title…" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Type</th>
            <th>Category</th>
            <th>Status</th>
            <th>Location</th>
            <th>Date Posted</th>
            <th>Reported By</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" alt="@item.Title"
                             style="width:60px;height:60px;object-fit:cover;border-radius:6px;" />
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td><strong>@item.Title</strong></td>
                <td>
                    <span class="badge @(item.Type == ItemType.Lost ? "badge-lost" : "badge-found") text-white">@item.Type</span>
                </td>
                <td>@item.Category</td>
                <td>
                    @{
                        var badgeClass = item.Status switch
                        {
                            ItemStatus.Active => "bg-success",
                            ItemStatus.Resolved => "bg-primary",
                            ItemStatus.Expired => "bg-secondary",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@item.Status</span>
                </td>
                <td>@item.Location</td>
                <td>@item.DatePosted.ToString("MMM d, yyyy")</td>
                <td>@item.User?.FullName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center mt-4">No items found.</p>
}
