@model LostFound.Models.Item

@{
    ViewData["Title"] = "Delete Item";
}

<h1>Delete Item</h1>
<hr />

<div class="alert alert-danger">Are you sure you want to delete this item?</div>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Category</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>

    <dt class="col-sm-2">Location</dt>
    <dd class="col-sm-10">@Model.Location</dd>

    <dt class="col-sm-2">Reported By</dt>
    <dd class="col-sm-10">@Model.User?.FullName</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Confirm Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
