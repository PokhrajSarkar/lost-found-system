@{
    ViewData["Title"] = "Privacy Policy";
}

<h2>Privacy Policy</h2>
<p class="text-muted">Last updated: @DateTime.Now.Year</p>

<div class="card shadow-sm p-4">
  <h5>Information We Collect</h5>
  <p>We collect information you provide when registering and posting items, including your name, email, and item details.</p>

  <h5>How We Use Your Information</h5>
  <p>Your information is used solely to operate the LostFound service — matching lost and found items and enabling contact between users.</p>

  <h5>Data Security</h5>
  <p>We use industry-standard security practices to protect your data. Passwords are hashed and never stored in plain text.</p>

  <h5>Contact</h5>
  <p>For any privacy concerns, please contact us through the site.</p>
</div>
