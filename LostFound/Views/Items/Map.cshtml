@{
    ViewData["Title"] = "Map View";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-map me-2"></i>Items Map</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">List View</a>
</div>

<div id="map" class="shadow"></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    var map = L.map('map').setView([20, 0], 2);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    var items = @Html.Raw(ViewBag.ItemsJson ?? "[]");
    var lostIcon = L.divIcon({ className: '', html: '<span style="font-size:1.4rem">🔴</span>' });
    var foundIcon = L.divIcon({ className: '', html: '<span style="font-size:1.4rem">🟢</span>' });

    items.forEach(function(item) {
        var icon = item.Type === 0 ? lostIcon : foundIcon;
        L.marker([item.Latitude, item.Longitude], { icon: icon })
            .addTo(map)
            .bindPopup('<strong>' + item.Title + '</strong><br>' + item.Location +
                '<br><a href="/Items/Details/' + item.Id + '">View Details</a>');
    });
</script>

<div class="mt-3 d-flex gap-3 small text-muted">
    <span>🔴 Lost items</span>
    <span>🟢 Found items</span>
    <span class="ms-auto">Only items with coordinates are shown. Add lat/lng when posting.</span>
</div>
